# HuggingFace token (optional -- CUAD is public but a token avoids rate limits)
HF_TOKEN=

# MLflow store (default: sqlite:///experiments/mlflow.db inside the repo)
# MLFLOW_TRACKING_URI=sqlite:///experiments/mlflow.db

# Serving
# CUAD_MODEL_PATH=models/run_3_lr2e-05_bs8_ep3_inverse
# CUAD_QUANTIZE=none          # none | int8 (CPU) | nf4 (GPU)
# CUAD_LOG_PREDICTIONS=0      # 1 = append predictions for src.eval.monitor
# CUAD_LOG_SNIPPET_CHARS=200  # 0 = never persist contract text in the log
# CUAD_MAX_CHARS=200000

# Train a different encoder
# CUAD_BASE_MODEL=microsoft/deberta-v3-base
